rules_version = '2';

// Dearly Club security rules.
//
// Orders, members, gifts and payment records are created only by the Cloud
// Functions (which bypass these rules), never directly by the website.
//
// The admin area: someone is an admin when a document exists at
// admins/{their user id}. Only the Firebase console (or the Functions) can
// create that document — nobody can make themselves an admin from the site.
// Admins can read the business records and make a few small updates
// (mark a letter shipped, mark a message handled). Everything else is locked.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // The update only touches these fields.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // A community member: signed in, email confirmed, has a profile, not paused.
    function isCommunityMember() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('suspended', false) != true;
    }

    // The Dearly Chat. All writes go through the Cloud Functions (which check
    // and set the free/member tier), so the browser can only read.
    match /profiles/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin() || isCommunityMember();
    }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }

    // Chat rooms: messages are read live in the browser; sending, deleting and
    // reporting go through the Cloud Functions. The free room is open to every
    // community member; members' rooms (Phase 11) need the paid tier.
    function isPaidMember() {
      return isCommunityMember()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('tier', 'free') == 'member';
    }
    match /rooms/{room}/messages/{id} {
      allow read: if isAdmin()
        || (room == 'the-dearly-club' && isCommunityMember())
        || (room in ['slow-rituals'] && isPaidMember());
    }

    // Pen Pal Match: each pair can read their own match, chat and (once both
    // have chosen to share) each other's address. Admins can read matches but
    // not the addresses. Everything is written by the Cloud Functions.
    function inMatch(id) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/penpals/$(id)).data.members;
    }
    match /penpalRequests/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
    }
    match /penpals/{id} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.members);
      match /messages/{msg} {
        allow read: if isAdmin() || inMatch(id);
      }
      match /addresses/{uid} {
        allow read: if inMatch(id)
          && (request.auth.uid == uid || get(/databases/$(database)/documents/penpals/$(id)).data.addressesShared == true);
      }
    }

    // Slow Rituals library: members read published rituals; Ariane writes them.
    match /rituals/{id} {
      allow read: if isAdmin() || (isPaidMember() && resource.data.published == true);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'month', 'intro', 'body', 'published', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() <= 20000
        && request.resource.data.published is bool;
      allow delete: if isAdmin();
    }

    // Reports and the text of hidden messages: admins only.
    match /reports/{id} {
      allow read: if isAdmin();
    }
    match /moderation/{id} {
      allow read: if isAdmin();
    }

    // Lets the admin area check "am I an admin?" for the signed-in user only.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChanges(['status', 'shippedAt', 'adminNote'])
        && request.resource.data.status in ['paid', 'shipped'];
    }

    match /members/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin() && onlyChanges(['adminNote']);
    }

    match /gifts/{id} {
      allow read: if isAdmin();
    }

    match /messages/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChanges(['status', 'handledAt'])
        && request.resource.data.status in ['new', 'handled'];
    }

    match /withdrawals/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChanges(['status', 'handledAt'])
        && request.resource.data.status in ['received', 'handled'];
    }

    // Mailing list. Admins can read it and take someone off it (never add).
    match /subscribers/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && onlyChanges(['status', 'unsubscribedAt', 'updatedAt'])
        && request.resource.data.status == 'unsubscribed';
    }

    match /campaigns/{id} {
      allow read: if isAdmin();
    }

    // Everything else (mail queue, gift codes, Stripe events, rate limits…)
    // stays closed to browsers.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
