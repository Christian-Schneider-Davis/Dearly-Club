# Copy to .env.local for local overrides. Never commit real keys.

# URL prefix the site is served from ('/' locally and on dearlyclub.eu,
# '/Dearly-Club/' on the GitHub Pages project URL — the deploy workflow sets this).
VITE_BASE=/

# The Firebase web config is public and lives in src/lib/firebase.js.
# Stripe keys are NOT used by the website: they are Firebase secrets
# (firebase functions:secrets:set STRIPE_SECRET_KEY).
