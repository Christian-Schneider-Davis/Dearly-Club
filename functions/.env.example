# Copy to functions/.env to override non-secret settings, then redeploy.
# Set to false only until Stripe Tax is set up in the Stripe dashboard.
STRIPE_TAX_ENABLED=true

# Public site address used in email links and images. Switch at launch.
SITE_URL=https://christian-schneider-davis.github.io/Dearly-Club/

# Where withdrawal notices (and later contact messages) are sent.
ADMIN_EMAIL=ariane.lignier@gmail.com

# Brevo → SMTP & API → SMTP → "SMTP login" (not secret; looks like 9a1b2c001@smtp-brevo.com).
# The SMTP key itself is a secret:  firebase functions:secrets:set BREVO_SMTP_KEY
BREVO_SMTP_LOGIN=
# Optional — these are the defaults:
# MAIL_FROM=Dearly Club <hello@dearlyclub.eu>
# MAIL_REPLY_TO=hello@dearlyclub.eu
